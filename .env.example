# ==============================================================================
# Secrets Configuration
# ==============================================================================
# IMPORTANT: This file contains ONLY secrets / env-specific overrides.
# Application config defaults belong in docker-compose.yml or src/config/.
# ==============================================================================

# Database
# POSTGRES_PASSWORD=your-password-here

# Redis
# REDIS_PASSWORD=your-redis-password

# ------------------------------------------------------------------------------
# LLM plane (inference-router) — see coding_client.llm.LLMSettings
# ------------------------------------------------------------------------------
# Provider selection (pgx-local/deepseek/...) happens server-side. Direct
# provider keys (OPENAI_API_KEY / ANTHROPIC_API_KEY / GROQ_API_KEY) are no
# longer used by coding-ai.
LLM_API_BASE_URL=http://inference-router.inference-router.svc.cluster.local:8150/api
LLM_API_KEY=
LLM_MODE=inference_router
LLM_API_TIMEOUT_SECONDS=300
# Names inference-router PROVIDERS, not models (coding_client.llm.LLMSettings
# default). The pgx vLLM model is requested as `local-llm` and defined once,
# in gitops scripts/host-configs/pgx/systemd/vllm.service.
LLM_ROUTING_DEFAULT_FALLBACK_CHAIN=pgx-local,deepseek

# GitHub (if needed)
# GITHUB_TOKEN=your-token

# ------------------------------------------------------------------------------
# Tenant trust
# ------------------------------------------------------------------------------
# X-Tenant-Id is a CLAIM, not a credential, and coding-ai reads it ABOVE license
# introspection. Any in-mesh caller that can open a socket to :8690 can assert
# any tenant. Set to false to ignore the header entirely — resolution then falls
# through to license introspection, and a forged header with no valid license
# gets a 401. Default (unset) is "true": today's behaviour.
# TRUST_TENANT_HEADER=false
#
# Tenant granted to a credential-less caller admitted by TRUSTED_CIDRS. There is
# NO default: unset means such callers are rejected rather than handed an
# invented tenant. Only meaningful together with a non-empty TRUSTED_CIDRS, and
# in production the service refuses to boot if TRUSTED_CIDRS is armed without it.
# DEFAULT_TENANT_ID=0195f48b-0000-7000-8000-000000000000
#
# Source networks admitted with NO credential at all. Empty by default — this is
# an authentication bypass, so a caller is trusted only if someone says so.
# TRUSTED_CIDRS=

# ------------------------------------------------------------------------------
# CORS
# ------------------------------------------------------------------------------
# Comma-separated list of browser origins allowed to call this service.
# Defaults to "*" (anonymous cross-origin reads only).
#
# Credentialed CORS (cookies / Authorization on cross-origin requests) is
# enabled automatically ONLY when this is an explicit origin list -- a wildcard
# origin can never be combined with credentials, because Starlette implements
# that by reflecting the caller's Origin back with
# Access-Control-Allow-Credentials: true, i.e. it allows every origin.
# CORS_ORIGINS=https://app.example,https://admin.example
